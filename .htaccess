RewriteEngine on

# SANTO CRISTO, ESPECIAL ALFONSO
RewriteRule ^auxiliares-parroquiales-de-cristo-sacerdote.html$ index.php?sec=especial [QSA]

# CATEGORIAS NOTICIAS
# http://web.mintrared.es/categoria-comunicados/2/

RewriteRule ^categoria-([0-9a-z-.]+)/([0-9]+)/?$ index.php?sec=noticias&cat=$2 [QSA]

# ARCHIVO NOTICIAS
# http://web.mintrared.es/archivo/01/2012/

RewriteRule ^archivo/([0-9]+)/([0-9]+)/?$ index.php?sec=noticias&archivo=1&mes=$1&anyo=$2 [QSA]

# PAGINAS ESTÁTICAS
# http://web.mintrared.es/la-parroquia/3/

RewriteRule ^([0-9a-z-._]+)/([0-9]+)/?$ index.php?sec=estaticas&m=$2 [QSA]
RewriteRule ^([0-9a-z-._]+)/([0-9]+)/carpeta-([0-9]+)/?$ index.php?sec=estaticas&m=$2&carpeta=$3 [QSA]

# NOTICIAS
# http://web.mintrared.es/noticia-de-prueba-3.html

RewriteRule ^(.*)-([0-9]+).html$ index.php?sec=noticia&m=$2 [QSA]

# GALERIA
# http://web.mintrared.es/galeria-fotografica.html

RewriteRule ^galeria-fotografica.html$ index.php?sec=galeria [QSA]
RewriteRule ^galeria-(.*)_([0-9]+).html$ index.php?sec=galeria&m=$2 [QSA]

# EVENTOS
# http://web.mintrared.es/eventos.html

RewriteRule ^eventos.html$ index.php?sec=eventos [QSA]
RewriteRule ^eventos/([0-9]+)-([0-9]+)-([0-9]+)/?$ index.php?sec=eventos&act=viewevents&dia=$1&mes=$2&anyo=$3 [QSA]

# LITURGIA
# http://web.mintrared.es/liturgia.html
# http://web.mintrared.es/liturgia/02-02-2012/
# http://web.mintrared.es/liturgia/02-02-2012/oficio-de-lectura_1/

RewriteRule ^liturgia.html$ index.php?sec=liturgia [QSA]
RewriteRule ^liturgia/([0-9]+)-([0-9]+)-([0-9]+)/?$ index.php?sec=liturgia&dia=$1&mes=$2&anyo=$3 [QSA]
RewriteRule ^liturgia/([0-9]+)-([0-9]+)-([0-9]+)/([0-9a-z-.]+)_([0-9]+)/?$ index.php?sec=liturgia&categoria=$4&idtexto=$5 [QSA]

# CONTACTO

RewriteRule ^contacto.html$ index.php?sec=contacto [QSA]

# SANTOS LISTADO

RewriteRule ^santos/?$ index.php?sec=todo-santos [QSA]
RewriteRule ^santos/([0-9]+)-([0-9]+)-([0-9]+)/?$ index.php?sec=todo-santos&dia=$1&mes=$2&anyo=$3 [QSA]
RewriteRule ^santos/?mes=([0-9]+)&anyo=([0-9]+)$ index.php?sec=todo-santos&mes=$1&anyo=$2 [QSA]

# SANTOS FICHA

RewriteRule ^santos/santo-([0-9a-z-.]+)_([0-9]+).html$ index.php?sec=santos&id=$2 [QSA]

# DOCUMENTOS

RewriteRule ^documentos/?$ index.php?sec=documentos [QSA]

# ENLACES AMIGOS

RewriteRule ^enlaces/?$ index.php?sec=enlaces [QSA]

# ULTIMAS NOTICIAS DIOCESIS

RewriteRule ^diocesis/?$ index.php?sec=diocesis [QSA]


# MISA EN VARIOS IDIOMAS

RewriteRule ^misa-en-varios-idiomas/?$ index.php?sec=misas [QSA]
RewriteRule ^misa-en-varios-idiomas/ciclo-(A|B|C)/?$ index.php?sec=misas&ciclo=$1 [QSA]

# ORACIONES Y LITURGIA

RewriteRule ^oraciones-y-liturgia/?$ index.php?sec=oraciones [QSA]
RewriteRule ^oraciones-y-liturgia/([0-9]+)-([0-9]+)-([0-9]+)/?$ index.php?sec=oraciones&dia=$1&mes=$2&anyo=$3 [QSA]

RewriteRule ^lectura-diaria/([0-9]+)-([0-9]+)-([0-9]+)/?$ index.php?sec=liturgia&only=lectura&dia=$1&mes=$2&anyo=$3 [QSA]

RewriteRule ^comentario/([0-9]+)-([0-9]+)-([0-9]+)/?$ index.php?sec=liturgia&only=comentario&dia=$1&mes=$2&anyo=$3 [QSA]

RewriteRule ^santoral/([0-9]+)-([0-9]+)-([0-9]+)/?$ index.php?sec=liturgia&only=santoral&dia=$1&mes=$2&anyo=$3 [QSA]

RewriteRule ^hoy-domingo/([0-9]+)-([0-9]+)-([0-9]+)/?$ index.php?sec=liturgia&only=hoydomingo&dia=$1&mes=$2&anyo=$3 [QSA]

# ORACIONES

RewriteRule ^oraciones.html$ index.php?sec=oracionesNew [QSA]

# GRUPOS PARROQUIALES

RewriteRule ^grupos-parroquiales.html$ index.php?sec=grupos [QSA]
RewriteRule ^grupos/([0-9a-z-.()]+)_([0-9]+).html$ index.php?sec=grupos&m=$2 [QSA]

RewriteRule ^misa-online.html$ index.php?sec=estaticas&m=misaonline [QSA]

RewriteRule ^feed/?$ feed.php [QSA]

# POLITICA PRIVACIDAD, AVISO LEGAL Y POLÍTICA DE COOKIES

RewriteRule ^politica-privacidad.html$ index.php?sec=politica [QSA]
RewriteRule ^aviso-legal.html$ index.php?sec=avisolegal [QSA]
RewriteRule ^cookies.html$ index.php?sec=cookies [QSA]